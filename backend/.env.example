PORT=4000
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/student_management

# 배포 환경에서 프론트엔드 도메인을 지정 (개발 환경은 Vite proxy를 쓰므로 비워둠)
CORS_ORIGIN=

# JWT 서명 키 (openssl rand -base64 32 등으로 직접 생성)
JWT_SECRET=<REQUIRED>

# Google Cloud Console에서 발급한 OAuth 2.0 클라이언트 ID
GOOGLE_CLIENT_ID=<REQUIRED>

# Google Calendar 연동(반 일정 단방향 동기화)에 필요한 값
# CLIENT_SECRET은 로그인용 ID 토큰 검증에는 필요 없고, Calendar 쓰기 권한 획득(OAuth 동의 화면)에만 사용
GOOGLE_CLIENT_SECRET=<REQUIRED>
# Google Cloud Console에 등록한 리다이렉트 URI와 정확히 일치해야 함
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:4000/api/auth/google-calendar/callback
# OAuth 콜백 처리 후 되돌아갈 프론트엔드 주소
FRONTEND_ORIGIN=http://localhost:5173
